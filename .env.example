# Supabase — from your project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only (never expose to the browser). Used by admin write actions / seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — outbound webhook fired when a job application is created.
# One or more URLs, comma-separated (e.g. an n8n webhook). Payload:
# { "event": "application.created", "data": {...}, "sent_at": "..." }
APPLY_WEBHOOK_URL=
# Optional — sent as the X-Webhook-Secret header so the receiver can verify.
APPLY_WEBHOOK_SECRET=
